# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Chave da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Supabase: Project Settings > API (ou Data API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (ou "secret key"): só no servidor, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Teto de gasto diário em US$. Acima dele, nenhuma chamada sai para a OpenAI.
TETO_DIARIO_USD=2

# Modelos por papel (opcional). Ao trocar, confira o preço em src/core/precos.ts.
# MODELO_LEVE=gpt-6-luna
# MODELO_MEDIO=gpt-6.1-terra
# MODELO_FORTE=gpt-6.1-sol
# MODELO_RERANK=gpt-6-luna
# MODELO_JUIZ=gpt-6.1-sol
# MODELO_EMBEDDING=text-embedding-3-small
